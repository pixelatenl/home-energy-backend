# Environment variables for the ingest worker.
# Copy to a .env file of your own choosing (for example ingest/.env) and load
# it at startup, or export the variables in the systemd unit/shell.
# This file belongs to the worker and is separate from the database .env.

# WebSocket endpoint of Home Assistant (if HA runs on the same server, this is localhost).
HA_WS_URL=ws://localhost:8123/api/websocket

# Long-lived access token: Home Assistant > Profile > Security > Long-lived access tokens.
HA_TOKEN=

# Database connection (pg reads these variables by itself).
PGHOST=192.168.1.10
PGPORT=5432
PGUSER=ems
PGPASSWORD=
PGDATABASE=energy
