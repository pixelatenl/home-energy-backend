# Example environment variables for the TimescaleDB stack.
# Copy to deploy/.env and fill in. The deploy-db.sh script does this automatically.
# This file belongs to the database and is separate from any .env of the dashboard.

# Password of the database user ems.
EMS_DB_PASSWORD=replace-with-a-strong-password

# Static LAN IP of the server; the database listens only on this address.
EMS_DB_BIND_IP=192.168.1.10
